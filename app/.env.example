# 复制为 app/.env.local，再填写智谱开放平台“普通 API”的 key。
ZAI_API_KEY=

# 以下已有默认值，通常不需要改。
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PHILO_CHAT_MODEL=glm-5.2
PHILO_CLASSIFIER_MODEL=glm-4.7-flash
# 日常对话默认直接输出，减少首字等待；复杂推理可改为 enabled。
PHILO_CHAT_THINKING=disabled

# 每位哲学家参与桌宠随机池的精选语录数；当前每位最多 5 条。
PHILO_QUOTE_TOP_N=5
